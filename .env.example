# ============================================================================
# MediKiosk AI - Production environment template
# Do NOT commit a real .env file or real secrets.
# ============================================================================

NODE_ENV=production
PORT=10000
APP_URL=https://YOUR-DOMAIN.example

# Gemini (server-side only)
GEMINI_API_KEY=

# Supabase frontend publishable key + URL
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase server configuration. Prefer the same publishable key only where the
# server intentionally performs user-scoped operations. A service-role/secret
# key must NEVER be exposed to Vite/frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HIS admin bootstrap credentials. REQUIRED if the legacy server-side admin
# console is still enabled; do not use the old demo defaults.
HIS_ADMIN_ID=
HIS_ADMIN_PIN=
ENABLE_DEMO_STAFF=false

# OpenStreetMap-compatible services
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ROUTING_PRIMARY_URL=https://router.project-osrm.org
VITE_OSM_ROUTING_MIRROR_URL=https://routing.openstreetmap.de
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_ROUTING_PRIMARY_URL=https://router.project-osrm.org
OSM_ROUTING_MIRROR_URL=https://routing.openstreetmap.de
OSM_USER_AGENT=MediKioskAI/1.0 (+https://YOUR-DOMAIN.example; contact: YOUR-CONTACT@example.com)

# Optional legacy Google variables. Core MediKiosk maps do not require them.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
